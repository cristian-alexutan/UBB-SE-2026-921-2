@model AirportWebApp.Models.AirportManagement.CompanyDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Company Dashboard";
}

@section Styles
{
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/company-representative.css" asp-append-version="true" />
}

<div class="topbar">
    <i class="bi bi-airplane-fill topbar-icon"></i>
    <span class="topbar-title">Flight Module</span>
</div>


<div class="page-wrap">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-3" role="alert">
            <strong>Flight could not be created.</strong>
            <div asp-validation-summary="All" class="mt-2"></div>
        </div>
    }

    <div class="flight-card">

        <!-- Header -->
        <div class="card-header-row">
            <span class="card-title">@Model.CompanyName's Flights</span>
            <button class="btn-add" id="openAddModal" title="Add Flight">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>

        <!-- Search -->
        <div class="search-wrap">
            <form method="get" asp-action="Index" id="searchForm">
                <input class="search-input"
                       type="text"
                       name="search"
                       value="@Model.SearchQuery"
                       placeholder="Search flights by flight number..."
                       id="searchInput" />
                <input type="hidden" name="companyId" value="@Model.CompanyId" />
            </form>
        </div>

        <!-- Table -->
        <table class="flight-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Flight No.</th>
                    <th>Date</th>
                    <th>Destination</th>
                    <th>Runway</th>
                    <th>Gate</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="flightTableBody">
                @if (!Model.Flights.Any())
                {
                    <tr>
                        <td colspan="7" class="no-flights">No flights found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var f in Model.Flights)
                    {
                        <tr>
                            <td class="td-id">@f.Id</td>
                            <td class="td-fnum">@f.FlightNumber</td>
                            <td class="td-date">@f.DateText</td>
                            <td>@f.DestinationText</td>
                            <td>@f.RunwayText</td>
                            <td>@f.GateText</td>
                            <td>
                                <button class="btn-delete"
                                        data-id="@f.Id"
                                        data-num="@f.FlightNumber"
                                        title="Delete flight">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</div>

<!-- add flight -->
<div class="modal-backdrop-custom @(ViewData.ModelState.IsValid ? string.Empty : "open")" id="addModal">
    <div class="modal-box">
        <div class="modal-title">Add Flight</div>

        <form method="post" asp-action="AddFlight" id="addFlightForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-grid">

                <!-- TYPE -->
				<div>
					<label asp-for="AddFlightForm.RouteType" class="form-label">Type</label>
					<select asp-for="AddFlightForm.RouteType" class="form-ctrl">
						<option value="">Arr / Dep</option>
						<option value="Arrival">Arrival</option>
						<option value="Departure">Departure</option>
					</select>
				</div>

                <!-- AIRPORT -->
                <div>
                    <label class="form-label">Airport</label>
                    <select class="form-ctrl" name="AirportId">
                        <option value="">Select Airport</option>
                        @if (Model.AddFlightForm?.Airports != null)
                        {
                            @foreach (var ap in Model.AddFlightForm.Airports)
                            {
                                <option value="@ap.Id">@ap.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- DEP. TIME -->
                <div>
                    <label class="form-label">Dep. Time</label>
                    <div class="time-row">
                        <input class="time-part" type="number" min="1" max="12"
                               name="DepHour" value="12" id="depHour" />
                        <span class="time-sep">:</span>
                        <input class="time-part" type="number" min="0" max="59"
                               name="DepMin" value="00" id="depMin" />
                        <select class="ampm-select" name="DepAmPm" id="depAmPm">
                            <option>AM</option>
                            <option selected>PM</option>
                        </select>
                    </div>
                </div>

                <!-- ARR. TIME -->
                <div>
                    <label class="form-label">Arr. Time</label>
                    <div class="time-row">
                        <input class="time-part" type="number" min="1" max="12"
                               name="ArrHour" value="1" id="arrHour" />
                        <span class="time-sep">:</span>
                        <input class="time-part" type="number" min="0" max="59"
                               name="ArrMin" value="00" id="arrMin" />
                        <select class="ampm-select" name="ArrAmPm" id="arrAmPm">
                            <option>AM</option>
                            <option selected>PM</option>
                        </select>
                    </div>
                </div>

                <!-- CAPACITY -->
				<div>
					<label asp-for="AddFlightForm.Capacity" class="form-label">Capacity</label>
					<input asp-for="AddFlightForm.Capacity" class="form-ctrl" placeholder="e.g. 180" />
					<span asp-validation-for="AddFlightForm.Capacity" class="text-danger small"></span>
				</div>

                <!-- RECURRENT CHECKBOX -->
                <div style="display:flex; align-items:flex-end; padding-bottom:.1rem;">
                    <div class="check-wrap">
                        <input type="checkbox" id="recurrentCheck" name="IsRecurrent" value="true" />
                        <label for="recurrentCheck">Recurrent Flight</label>
                    </div>
                </div>

                <!-- DATE (single) -->
                <div id="singleDateWrap">
                    <label class="form-label">Date</label>
                    <input class="form-ctrl" type="date" name="SingleDate"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <!-- GATE -->
                <div>
                    <label class="form-label">Gate</label>
                    <select class="form-ctrl" name="GateId">
                        <option value="">Select Gate</option>
                        @if (Model.AddFlightForm?.Gates != null)
                        {
                            @foreach (var g in Model.AddFlightForm.Gates)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- RUNWAY (full width) -->
                <div class="full">
                    <label class="form-label">Runway</label>
                    <select class="form-ctrl" name="RunwayId">
                        <option value="">Select Runway</option>
                        @if (Model.AddFlightForm?.Runways != null)
                        {
                            @foreach (var r in Model.AddFlightForm.Runways)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- RECURRENT SECTION -->
                <div id="recurrent-section" class="full">
                    <div class="rec-grid">

                        <!-- Start Date -->
                        <div>
                            <label class="form-label">Start Date</label>
                            <input class="form-ctrl" type="date" name="StartDate"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <!-- End Date -->
                        <div>
                            <label class="form-label">End Date</label>
                            <input class="form-ctrl" type="date" name="EndDate"
                                   value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" />
                        </div>

                        <!-- Recurrence Type -->
                        <div class="full">
                            <label class="form-label">Recurrence Type</label>
                            <select class="form-ctrl" name="RecurrenceType" id="recurrenceType">
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Custom">Custom Days</option>
                            </select>
                        </div>

                        <!-- Custom Interval -->
                        <div class="full" id="custom-days-wrap">
                            <label class="form-label">Custom Interval (days)</label>
                            <input class="form-ctrl" type="number" name="CustomDaysText" id="customDaysText"
                                   min="1" step="1" value="1" placeholder="e.g. 3" />
                        </div>

                    </div>
                </div>

            </div>

            <div class="modal-footer-btns">
                <button type="submit" class="btn-save">Save Flight</button>
                <button type="button" class="btn-cancel" id="cancelAdd">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!--delete-->
<div class="modal-backdrop-custom" id="deleteModal">
    <div class="modal-box confirm-box">
        <div class="modal-title">Delete Flight</div>
        <p id="deleteConfirmText">Are you sure you want to delete this flight?</p>
        <form method="post" asp-action="DeleteFlight" id="deleteForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteFlightId" />
            <div class="modal-footer-btns">
                <button type="submit" class="btn-danger-confirm">Delete</button>
                <button type="button" class="btn-cancel" id="cancelDelete">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/company-representative.js" asp-append-version="true"></script>
}

