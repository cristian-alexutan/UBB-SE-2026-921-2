@model AirportWebApp.Models.AirportManagement.EmployeesDashboardViewModel
@{
	Layout = "_AdministrationLayout";
	ViewData["Title"] = "Employee Administration";
}

<div class="container-fluid bg-dark-navy text-white min-vh-100 p-4">
	<h2 class="fw-bold mb-4">EMPLOYEE ADMINISTRATION</h2>

	<div class="row row-cols-1 row-cols-md-2 g-4">
		@foreach (var employee in Model.Employees)
		{
			<div class="col">
				<div class="card bg-slate border-secondary shadow-sm">
					<div class="card-body d-flex justify-content-between align-items-center">
						<div>
							<h5 class="mb-1">@employee.Name</h5>
							<span class="badge bg-info">@employee.Role</span>
						</div>
						<form asp-action="ExecuteRemoveEmployee" asp-route-employeeId="@employee.Id" method="post">
							<button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
						</form>
					</div>
				</div>
			</div>
		}
	</div>
</div>